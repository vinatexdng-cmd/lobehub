# Vinatex Da Nang - LobeHub production template
# Copy this file to .env on the production server.
# NEVER commit the real .env or any API keys/passwords.

LOBE_PORT=3210
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
APP_URL=https://ai.vinatexdn.com.vn
INTERNAL_APP_URL=http://localhost:3210

# Generate strong random secrets on the server
KEY_VAULTS_SECRET=CHANGE_ME
AUTH_SECRET=CHANGE_ME
GATEWAY_SERVICE_TOKEN=CHANGE_ME
JWKS_KEY=CHANGE_ME
JWKS_PUBLIC_KEY=CHANGE_ME

# Database
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=CHANGE_ME

# Object storage / Knowledge Base
# Browser-facing endpoint must be reachable by employee browsers when file upload is enabled.
S3_ENDPOINT=https://files-ai.vinatexdn.com.vn
RUSTFS_ACCESS_KEY=vinatex-ai
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_LOBE_BUCKET=lobe

# Agent Gateway
AGENT_GATEWAY_PORT=8787
DEVICE_GATEWAY_PORT=8788
AGENT_GATEWAY_URL=https://gateway-ai.vinatexdn.com.vn
DEVICE_GATEWAY_URL=http://gateway:8788

# Authentication policy
# Phase 1: enable only approved pilot users by setting AUTH_ALLOWED_EMAILS.
# AUTH_ALLOWED_EMAILS=user1@vinatexdn.com.vn,user2@vinatexdn.com.vn
# Phase 2: enable this after Microsoft Entra ID / other SSO is configured.
# AUTH_DISABLE_EMAIL_PASSWORD=1

# AI providers - server side only
OPENAI_API_KEY=CHANGE_ME
GOOGLE_API_KEY=CHANGE_ME
DEEPSEEK_API_KEY=CHANGE_ME

# Keep the employee model list intentionally small and easy to understand.
# Verify provider/model identifiers against the LobeHub version deployed before enabling aliases.
# OPENAI_MODEL_LIST=...
# GOOGLE_MODEL_LIST=...
# DEEPSEEK_MODEL_LIST=...

# Optional Elasticsearch. PostgreSQL pg_search remains the default.
# COMPOSE_PROFILES=elasticsearch
# ES_URL=http://elasticsearch:9200
# ES_ALLOW_INSECURE_HTTP=true
# ES_INDEX_NAMESPACE=lobehub
