# Vinatex Da Nang - LobeHub on Vercel
# TEMPLATE ONLY. Never commit real passwords, API keys or secrets.

# Public application URL
APP_URL=https://ai.vinatexdn.com.vn

# Database - Neon PostgreSQL
DATABASE_DRIVER=node
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required secrets - generate unique strong values and store in Vercel Environment Variables
KEY_VAULTS_SECRET=REPLACE_WITH_STRONG_SECRET
AUTH_SECRET=REPLACE_WITH_STRONG_SECRET

# Optional Redis - use a managed Redis provider
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
REDIS_PREFIX=lobehub

# Object storage / Knowledge Base - S3-compatible service (for example Cloudflare R2)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=vinatex-lobehub
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0

# AI providers - server-side only
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY

# Login policy (enable after pilot accounts are confirmed)
# AUTH_ALLOWED_EMAILS=user1@vinatexdn.com.vn,user2@vinatexdn.com.vn
# AUTH_DISABLE_EMAIL_PASSWORD=1

# Notes
# 1. Do not add this populated file to Git.
# 2. Add real values in Vercel Project > Settings > Environment Variables.
# 3. Keep the repository's vercel.json build command: bun run build:vercel.
